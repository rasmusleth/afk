{
  "name": "afk",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "pnpm --filter @afk/web dev",
    "build": "pnpm --filter @afk/web build",
    "start": "pnpm --filter @afk/web start",
    "lint": "eslint .",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r --if-present test",
    "studio": "pnpm --filter @afk/studio dev",
    "studio:build": "pnpm --filter @afk/studio build",
    "studio:schema": "pnpm --filter @afk/studio schema",
    "sync:schedule": "pnpm --filter @afk/importer sync",
    "sync:details": "pnpm --filter @afk/importer sync:details",
    "stats:report": "pnpm --filter @afk/importer stats:report",
    "sync:competition": "pnpm --filter @afk/importer sync:competition"
  },
  "devDependencies": {
    "@types/node": "^20",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "typescript": "^6.0.3"
  },
  "packageManager": "pnpm@12.11.2"
}
