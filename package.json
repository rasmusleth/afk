{
  "name": "afk-next",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "node --test sports/*.test.ts sanity/schemaTypes/*.test.ts",
    "studio": "sanity dev",
    "studio:build": "sanity build --yes",
    "studio:schema": "sanity schema extract --path .sanity/schema.json --force"
  },
  "dependencies": {
    "next": "16.4.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "sanity": "^6.20.0",
    "styled-components": "^6.6.0"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.0",
    "tailwindcss": "^4",
    "typescript": "^6.0.3"
  },
  "packageManager": "pnpm@12.11.2"
}
